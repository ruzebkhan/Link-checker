<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Phishing URL Detector</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Arial, sans-serif; }
  body {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .card {
    background: #ffffff;
    border-radius: 16px;
    padding: 32px;
    width: 100%;
    max-width: 480px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
  }
  h1 {
    font-size: 24px;
    color: #1e293b;
    margin-bottom: 6px;
    text-align: center;
  }
  p.subtitle {
    text-align: center;
    color: #64748b;
    font-size: 14px;
    margin-bottom: 24px;
  }
  .input-group {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }
  input[type="text"] {
    flex: 1;
    padding: 12px 14px;
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    font-size: 15px;
    outline: none;
    transition: border 0.2s;
  }
  input[type="text"]:focus { border-color: #3b82f6; }
  button {
    padding: 12px 20px;
    background: #3b82f6;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  button:hover { background: #2563eb; }
  .result {
    border-radius: 10px;
    padding: 18px;
    display: none;
    animation: fadeIn 0.3s ease-in;
  }
  @keyframes fadeIn { from {opacity:0; transform: translateY(-6px);} to {opacity:1; transform: translateY(0);} }
  .result.safe { background: #dcfce7; border: 2px solid #22c55e; }
  .result.suspicious { background: #fef9c3; border: 2px solid #eab308; }
  .result.danger { background: #fee2e2; border: 2px solid #ef4444; }
  .result h2 { font-size: 18px; margin-bottom: 8px; }
  .result.safe h2 { color: #15803d; }
  .result.suspicious h2 { color: #a16207; }
  .result.danger h2 { color: #b91c1c; }
  .score-bar {
    height: 10px;
    width: 100%;
    background: #e2e8f0;
    border-radius: 5px;
    overflow: hidden;
    margin: 10px 0;
  }
  .score-fill {
    height: 100%;
    border-radius: 5px;
    transition: width 0.4s ease;
  }
  ul.reasons {
    margin-top: 10px;
    padding-left: 20px;
    font-size: 13px;
    color: #334155;
  }
  ul.reasons li { margin-bottom: 4px; }
  .footer-note {
    margin-top: 20px;
    font-size: 12px;
    color: #94a3b8;
    text-align: center;
  }
</style>
</head>
<body>

<div class="card">
  <h1>🔍 Phishing URL Detector</h1>
  <p class="subtitle">Heuristic-based scan of any URL for common phishing red flags</p>

  <div class="input-group">
    <input type="text" id="urlInput" placeholder="Enter URL e.g. http://example.com/login" />
    <button onclick="analyzeURL()">Check</button>
  </div>

  <div id="result" class="result">
    <h2 id="resultTitle"></h2>
    <div class="score-bar">
      <div class="score-fill" id="scoreFill"></div>
    </div>
    <p id="scoreText" style="font-size:13px; color:#475569;"></p>
    <ul class="reasons" id="reasonsList"></ul>
  </div>

  <p class="footer-note">⚠️ This tool uses simple heuristics only and is for educational/awareness purposes. It is not a substitute for proper security software.</p>
</div>

<script>
function analyzeURL() {
  const input = document.getElementById('urlInput').value.trim();
  const resultBox = document.getElementById('result');
  const titleEl = document.getElementById('resultTitle');
  const fillEl = document.getElementById('scoreFill');
  const scoreText = document.getElementById('scoreText');
  const reasonsList = document.getElementById('reasonsList');

  if (!input) {
    alert('Please enter a URL to check.');
    return;
  }

  let url = input;
  if (!/^https?:\/\//i.test(url)) {
    url = 'http://' + url;
  }

  let score = 0; // higher = more suspicious
  const reasons = [];

  let parsed;
  try {
    parsed = new URL(url);
  } catch (e) {
    titleEl.textContent = '❌ Invalid URL format';
    resultBox.className = 'result danger';
    resultBox.style.display = 'block';
    fillEl.style.width = '100%';
    fillEl.style.background = '#ef4444';
    scoreText.textContent = 'Could not parse this as a valid URL.';
    reasonsList.innerHTML = '';
    return;
  }

  const hostname = parsed.hostname;
  const fullUrl = url.toLowerCase();

  // 1. IP address instead of domain name
  const ipPattern = /^(\d{1,3}\.){3}\d{1,3}$/;
  if (ipPattern.test(hostname)) {
    score += 25;
    reasons.push('Uses an IP address instead of a domain name');
  }

  // 2. "@" symbol in URL (can hide real destination)
  if (url.includes('@')) {
    score += 20;
    reasons.push('Contains "@" symbol, which can mask the real destination');
  }

  // 3. Not using HTTPS
  if (parsed.protocol !== 'https:') {
    score += 10;
    reasons.push('Does not use HTTPS (no SSL encryption)');
  }

  // 4. Excessive URL length
  if (url.length > 75) {
    score += 10;
    reasons.push('URL is unusually long (' + url.length + ' characters)');
  }

  // 5. Many subdomains / dots
  const dotCount = hostname.split('.').length - 1;
  if (dotCount > 3) {
    score += 15;
    reasons.push('Excessive number of subdomains in the hostname');
  }

  // 6. Hyphens in domain (often used to mimic brands, e.g. paypal-secure.com)
  if (hostname.includes('-')) {
    score += 10;
    reasons.push('Hyphen(s) in domain name, often used to mimic legitimate brands');
  }

  // 7. Suspicious keywords
  const suspiciousWords = ['login', 'verify', 'update', 'secure', 'account', 'bank', 'confirm', 'signin', 'webscr', 'password', 'free', 'bonus'];
  const foundWords = suspiciousWords.filter(w => fullUrl.includes(w));
  if (foundWords.length > 0) {
    score += foundWords.length * 8;
    reasons.push('Contains suspicious keyword(s): ' + foundWords.join(', '));
  }

  // 8. URL shortener services
  const shorteners = ['bit.ly', 'tinyurl.com', 'goo.gl', 't.co', 'is.gd', 'ow.ly', 'cutt.ly', 'shorturl.at'];
  if (shorteners.some(s => hostname.includes(s))) {
    score += 20;
    reasons.push('Uses a known URL shortening service, which can hide the real destination');
  }

  // 9. Many digits in domain
  const digitCount = (hostname.match(/\d/g) || []).length;
  if (digitCount >= 4) {
    score += 10;
    reasons.push('Domain contains an unusually high number of digits');
  }

  // 10. Multiple "." before the actual TLD pattern look (e.g. fake subdomain trick)
  const knownTLDs = ['com', 'org', 'net', 'in', 'co', 'io', 'gov', 'edu', 'info', 'biz'];
  const parts = hostname.split('.');
  if (parts.length >= 2) {
    const secondLast = parts[parts.length - 2];
    if (knownTLDs.includes(secondLast) && parts.length > 2) {
      score += 15;
      reasons.push('Domain structure looks like it is impersonating a known TLD pattern');
    }
  }

  // Cap score at 100
  if (score > 100) score = 100;

  // Determine verdict
  let verdict, cssClass, color;
  if (score < 25) {
    verdict = '✅ Likely Safe';
    cssClass = 'safe';
    color = '#22c55e';
  } else if (score < 55) {
    verdict = '⚠️ Suspicious — Be Careful';
    cssClass = 'suspicious';
    color = '#eab308';
  } else {
    verdict = '🚨 High Risk — Likely Phishing';
    cssClass = 'danger';
    color = '#ef4444';
  }

  if (reasons.length === 0) {
    reasons.push('No common phishing indicators detected');
  }

  titleEl.textContent = verdict;
  resultBox.className = 'result ' + cssClass;
  resultBox.style.display = 'block';
  fillEl.style.width = score + '%';
  fillEl.style.background = color;
  scoreText.textContent = 'Risk score: ' + score + ' / 100';
  reasonsList.innerHTML = reasons.map(r => '<li>' + r + '</li>').join('');
}

document.getElementById('urlInput').addEventListener('keypress', function(e) {
  if (e.key === 'Enter') analyzeURL();
});
</script>

</body>
</html>
